<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>AIRsLight.ClashOfRim.ThirdPartyCompat</AssemblyName>
    <RootNamespace>AIRsLight.ClashOfRim.ThirdPartyCompat</RootNamespace>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <OutputPath>..\..\Assemblies\AIRsLight.ClashOfRim.ThirdPartyCompat\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup Condition="'$(NuGetPackageRoot)' == ''">
    <NuGetPackageRoot>$(UserProfile)\.nuget\packages\</NuGetPackageRoot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Source\Client\ClashOfRim.csproj" PrivateAssets="all" Private="false" />
    <ProjectReference Include="..\..\Source\Shared\ClashOfRim.Compatibility\ClashOfRim.Compatibility.csproj" PrivateAssets="all" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\ThirdPartyCompatibilityPackageKeys.cs" Link="ThirdPartyCompatibilityPackageKeys.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(NuGetPackageRoot)krafs.rimworld.ref\1.6.4566\ref\net472\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(NuGetPackageRoot)krafs.rimworld.ref\1.6.4566\ref\net472\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(NuGetPackageRoot)lib.harmony\2.4.1\lib\net472\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="RemoveHostAssembliesFromCopyLocal" BeforeTargets="CopyFilesToOutputDirectory">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.Filename)' == 'AIRsLight.ClashOfRim' Or '%(ReferenceCopyLocalPaths.Filename)' == 'ClashOfRim.Compatibility'" />
    </ItemGroup>
  </Target>

  <Target Name="DeleteHostAssembliesFromOutput" AfterTargets="Build">
    <Delete Files="$(TargetDir)AIRsLight.ClashOfRim.dll;$(TargetDir)AIRsLight.ClashOfRim.pdb;$(TargetDir)ClashOfRim.Compatibility.dll;$(TargetDir)ClashOfRim.Compatibility.pdb" />
  </Target>
</Project>
